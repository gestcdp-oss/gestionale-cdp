# Copia questo file in ".env.local" (che NON viene versionato) e riempi i valori.
# .env.local serve sia al dev server Vite sia agli script di amministrazione.

# --- Pubblici (finiscono nel bundle: nessun segreto qui) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# --- Privati (SOLO in locale, mai committati) ---
# Personal Access Token Supabase (Management API), opzionale
SUPABASE_PAT=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=<project-ref>

# Connessione Postgres diretta (pooler, session mode) per scripts/run-sql.mjs
SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=<db-password>
SUPABASE_DB_NAME=postgres
